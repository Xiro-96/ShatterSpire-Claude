# ─────────────────────────────────────────────────────────────
#  Line endings
#  Unity serialises its YAML with LF. Without this, every file
#  touched on Windows shows up as a full-file diff.
# ─────────────────────────────────────────────────────────────
* text=auto eol=lf

# ─────────────────────────────────────────────────────────────
#  Unity YAML — text, so diffs and merges are readable
#  (Serialization Mode is Force Text, verified in EditorSettings)
#
#  Optional but recommended once per machine, wires up Unity's
#  own YAML merge tool so scene/prefab conflicts are resolvable:
#    git config merge.unityyamlmerge.driver \
#      '"<Unity>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %A'
#  Until that is configured git falls back to its normal merge.
# ─────────────────────────────────────────────────────────────
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial     text eol=lf merge=unityyamlmerge
*.playable   text eol=lf merge=unityyamlmerge
*.mask       text eol=lf merge=unityyamlmerge
*.terrainlayer       text eol=lf merge=unityyamlmerge
*.meta       text eol=lf merge=unityyamlmerge

# Plain text
*.cs         text eol=lf diff=csharp
*.asmdef     text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.shader     text eol=lf
*.hlsl       text eol=lf
*.cginc      text eol=lf
*.compute    text eol=lf

